+      const nodes = this.root.children;
+      let at = -1;
+      nodes.forEach((c, i) => { if (key(c) === 'event') at = i; });
+      if (at === -1) at = nodes.findIndex(c => key(c) === 'changes') - 1;
+      if (at < -1) at = nodes.length - 1;
+      nodes.splice(at + 1, 0, n);
+      return n;
+    }
