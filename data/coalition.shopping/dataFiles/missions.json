        "values": [
          "New Equipment"
        ],
        "children": null
      },
      {
        "key": "description",
        "values": [
          "Head to <destination> to check out the shipyards and outfitter you've paid to get access to."
        ],
        "children": null
      },
      {
        "key": "source",
        "values": [],
        "children": [
          {
            "key": "government",
            "values": [
              "Coalition"
            ],
            "children": null
          },
          {
