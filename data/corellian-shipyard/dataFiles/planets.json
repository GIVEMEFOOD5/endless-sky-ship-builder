    "requires": [],
    "landscapes": [],
    "music": null,
    "description": {
      "text": "\tA century ago, some entrepreneurs settled here and built a factory complex that is entirely powered by wind and solar energy, because there are so few cloudy days here and the wind and sunshine are so reliable. The factory is mostly autonomous, with only a few thousand people living here to perform maintenance or to grow crops in irrigated fields.",
      "toDisplay": null
    },
    "spaceport": {
      "text": "\tThe living quarters have been modestly decorated for Remembrance Day, with ceremonial flags displayed inside the dining hall and Alpha Wars medals set up along a corridor, each one belonging to an ancestor of those who immigrated here.",
      "toDisplay": [
        "\"days since year start\" > 35",
        "\"days since year start\" < 55"
      ]
    },
