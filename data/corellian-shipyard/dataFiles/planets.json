    "landscapes": [],
    "music": null,
    "description": {
      "text": "\tThe Syndicate is a fair employer: living conditions here may be squalid, but most workers are earning a living wage and some are able to save up for a new life on a more pleasant planet. The Syndicate trusts there will never be a shortage of new immigrants to replace them.",
      "toDisplay": null
    },
    "spaceport": {
      "text": "\tBeyond the spaceport, you can see endless rows of apartment buildings receding into the horizon. Any variation in design or color from one to the next is well-hidden by the layers of filth.",
      "toDisplay": null
    },
