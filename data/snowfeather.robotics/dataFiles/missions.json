            "children": null
          },
          {
            "key": "conversation",
            "values": [],
            "children": [
              {
                "key": "You land on <planet>. Dr. Lufbin pays you 250.000 credits.",
                "values": [],
                "children": null
              },
              {
                "key": "\"I will send you a message when I'm done with the work.\"",
                "values": [],
                "children": null
              }
            ]
          }
        ]
      }
