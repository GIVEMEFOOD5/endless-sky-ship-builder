    {
      "name": "Medium Graviton Thruster b",
      "display name": "Medium Graviton Thruster",
      "category": "Engines",
      "series": "Engines",
      "index": 91021,
      "cost": 20000000,
      "thumbnail": "outfit/medium quarg thruster",
      "mass": 70,
      "outfit space": -70,
      "engine capacity": -70,
      "thrust": 120,
      "thrusting energy": 8,
      "thrusting heat": 2,
      "reverse thrust": 60,
      "reverse thrusting energy": 4,
      "reverse thrusting heat": 1,
      "force protection": 0.15,
      "inertia reduction": 0.15,
      "flare sprite": "effect/graviton flare/graviton flare",
      "flare sprite data": {
        "frame rate": 5
      },
      "description": "Quarg thrusters are quite powerful for their size and produce very little heat, but at the cost of consuming immense amounts of energy. The mechanism by which they produce thrust is unknown, but it is rumored that the passing of a Quarg ship wreaks havoc on every gravitational wave antenna in the system. \tThey also have strange capabilities which seem to violate the laws of physics as humanity understands them. Ships with these engines accelerate faster under their own power than one would expect, while also taking less impact from external forces.",
