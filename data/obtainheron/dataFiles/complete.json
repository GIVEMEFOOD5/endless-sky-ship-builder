              "key": "dialog",
              "values": [],
              "children": [
                {
                  "key": "You have taken a liking towards this ship, You wonder if they would let you keep it.",
                  "values": [],
                  "children": null
                }
              ]
            }
          ]
        },
        {
          "key": "on",
          "values": [
            "enter",
            "Vaticanus"
          ],
          "children": [
            {
              "key": "dialog",
              "values": [],
              "children": [
                {
                  "key": "The derelict ship oddly resemble a remant ship, But you've never seen this ship before.",
                  "values": [],
                  "children": null
                }
              ]
            }
