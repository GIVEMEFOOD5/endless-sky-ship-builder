+
+/* ══════════════════════════════════════════════════════════════════
+   Mobile & touch
+   One layer for every page: nothing wider than the screen, controls big
+   enough for a finger, and no zoom-jump when tapping a text box (iOS
+   zooms into any input under 16px).
+   ══════════════════════════════════════════════════════════════════ */
+img, video, canvas { max-width: 100%; }
+/* a panel holding an open type-ahead list sits above the panels after it */
+.panel:focus-within { position: relative; z-index: 4; }
+.sv-jump { display: flex; flex-wrap: wrap; gap: 4px; font-size: 0.8rem; }
+.button-group { flex-wrap: wrap; }
+.mission-raw-line { white-space: pre-wrap; overflow-wrap: anywhere; }
+.list-row__label, .ld-pill, .fleet-card__name { overflow-wrap: anywhere; }
+
+@media (max-width: 640px) {
+    /* tab strips scroll sideways instead of pushing the page wider */
+    .tabs { overflow-x: auto; flex-wrap: nowrap; gap: 6px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
+    .tabs::-webkit-scrollbar { display: none; }
+    .tabs .tab { flex: 0 0 auto; padding: 10px 14px; white-space: nowrap; }
+    .button-group > .btn { flex: 1 1 calc(50% - 10px); }
+    .toast { left: 12px; right: 12px; bottom: 12px; text-align: center; }
+    .uk-toast { left: 12px; right: 12px; transform: none; justify-content: space-between; }
+    .modal-box, .modal-box--detail { padding: 18px; border-radius: 14px; }
+    .modal-box--detail { max-height: 92dvh; }
+    .panel { padding-left: 14px; padding-right: 14px; }
+    h1 { word-break: break-word; }
+    /* save editor: jump links in one sideways-scrolling row, so the sticky bar stays short */
+    .sv-jump { flex-wrap: nowrap; overflow-x: auto; width: 100%; scrollbar-width: none; padding-bottom: 2px; }
+    .sv-jump::-webkit-scrollbar { display: none; }
+    .sv-jump .ld-pill { flex: 0 0 auto; white-space: nowrap; }
+}
+@media (max-width: 380px) {
+    /* very narrow phones: card thumbnails above the text, details in one column */
+    .card-inner { flex-wrap: wrap; }
+    .card-details { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+    .detail-value, .detail-label { overflow-wrap: anywhere; }
+}
+
+@media (pointer: coarse) {
+    .btn { min-height: 40px; }
+    .btn.btn-sm, .btn-sm { min-height: 36px; }
+    .btn-remove, .sorter-move-btn, .sorter-remove-btn, .modal-close { min-width: 36px; min-height: 36px; }
+    .btn-compare, .mtl-more, .compare-toggle__btn, #sbs-root .sbs-tab, .sbs-collapse-btn,
+    .btn-cleanup-remove, .btn-cleanup-remove-all { min-height: 36px; }
+    input[type="checkbox"], input[type="radio"] { width: 20px; height: 20px; flex-shrink: 0; }
+    input:not([type="checkbox"]):not([type="radio"]):not([type="range"]), select, textarea { font-size: 16px; }
+    .uk-combo__item { padding: 11px 12px; }
+    a.ld-pill, nav a.ld-pill { display: inline-flex; align-items: center; min-height: 32px; }
+    .team-remove-btn { min-width: 36px; min-height: 36px; }
+    .team-name-input, .team-count-input { min-height: 36px; }
+    .map-trade-sys { padding: 6px 2px !important; }
+    .map-layers input[type="checkbox"], .map-toggle-row input[type="checkbox"] { width: 20px; height: 20px; }
+    .es-nav__brand { padding-top: 6px; padding-bottom: 6px; }
+}
diff --git a/Display/JavaScript/UserManagerMissionDisplay.js b/Display/JavaScript/UserManagerMissionDisplay.js
index a3787ce..9a498e8 100644
--- a/Display/JavaScript/UserManagerMissionDisplay.js
+++ b/Display/JavaScript/UserManagerMissionDisplay.js
@@ -262,9 +262,40 @@ function applyFiltersAndRender() {
     currentMissions = new Map(filtered.map(m => [m.id, m]));
 
     countLabel.textContent = `${filtered.length} mission${filtered.length === 1 ? '' : 's'}`;
+    // Draw cards in batches: thousands of missions at once made phones
+    // (and slower computers) stall. More are added as you scroll near the
+    // end, or with the button.
+    lastFiltered = filtered;
+    shownCount = Math.min(filtered.length, MISSION_BATCH);
     listEl.innerHTML = filtered.length
-        ? filtered.map(cardHtml).join('')
+        ? filtered.slice(0, shownCount).map(cardHtml).join('') + moreButtonHtml()
         : '<p class="mission-empty">No missions match.</p>';
+    watchMore();
+}
+
+const MISSION_BATCH = 60;
+let lastFiltered = [], shownCount = 0, moreObserver = null;
+function moreButtonHtml() {
+    const left = lastFiltered.length - shownCount;
+    return left > 0 ? `<button class="btn btn-secondary" id="missionShowMore" style="width:100%;margin-top:10px;">Show ${Math.min(left, MISSION_BATCH)} more (${left} left)</button>` : '';
+}
+function showMoreMissions() {
+    const btn = document.getElementById('missionShowMore');
+    if (!btn) return;
+    const next = lastFiltered.slice(shownCount, shownCount + MISSION_BATCH);
+    shownCount += next.length;
+    btn.insertAdjacentHTML('beforebegin', next.map(cardHtml).join(''));
+    btn.outerHTML = moreButtonHtml();
+    watchMore();
+}
+function watchMore() {
+    const btn = document.getElementById('missionShowMore');
+    if (!btn) return;
+    btn.onclick = showMoreMissions;
+    if (!('IntersectionObserver' in window)) return;
+    if (moreObserver) moreObserver.disconnect();
+    moreObserver = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) showMoreMissions(); }, { rootMargin: '600px' });
+    moreObserver.observe(btn);
 }
 
 function cardHtml(m) {
